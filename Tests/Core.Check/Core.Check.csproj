<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity Core sources against netstandard2.1 + C# 9 to catch APIs Unity can't use. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Sculpt.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CoreSourceDir)**\*.cs" />
  </ItemGroup>
</Project>
